{
  "rules": {
    ".read": false,
    ".write": false,
    "poules": {
      "$code": {
        ".read": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".write": "data.exists() && !newData.exists() && newData.parent().parent().child('deletions').child($code).isString() && root.child('owners').child($code).child(newData.parent().parent().child('deletions').child($code).val()).exists()",
        "meta": {
          ".write": "!data.exists() && $code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
          ".validate": "newData.hasChildren(['id', 'name', 'fencers', 'bouts'])"
        },
        "results": {
          "$bout": {
            ".write": "root.child('poules').child($code).child('meta').exists() && $bout.length <= 80",
            ".validate": "newData.hasChildren(['scoreL', 'scoreR', 'winnerId']) && newData.child('scoreL').isNumber() && newData.child('scoreR').isNumber() && newData.child('scoreL').val() >= 0 && newData.child('scoreL').val() <= 99 && newData.child('scoreR').val() >= 0 && newData.child('scoreR').val() <= 99 && newData.child('winnerId').isString() && newData.child('winnerId').val().length <= 80"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "owners": {
      "$code": {
        "$key": {
          ".write": "!data.exists() && !root.child('poules').child($code).child('meta').exists() && $code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
          ".validate": "newData.isBoolean() && $key.length >= 20 && $key.length <= 64"
        }
      }
    },
    "deletions": {
      "$code": {
        ".write": "root.child('owners').child($code).exists()",
        ".validate": "newData.isString() && newData.val().length <= 64"
      }
    },
    "booking": {
      "publicKey": {
        ".read": true,
        ".write": "!data.exists() && newData.isString() && newData.val().length < 1000"
      },
      "privateKey": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['salt', 'iv', 'data'])"
      },
      "admin": {
        "$secret": {
          ".write": "!root.child('booking').child('admin').exists() && $secret.length == 64",
          ".validate": "newData.val() === true"
        }
      },
      "sessions": {
        ".read": true,
        "$s": {
          "$b": {
            ".write": "(!data.exists() && newData.exists() && $s.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]{1,40}$/) && $b.length <= 40) || (data.exists() && !newData.exists() && ((newData.parent().parent().parent().child('cancels').child($s).child($b).isString() && root.child('booking').child('keys').child($s).child($b).child(newData.parent().parent().parent().child('cancels').child($s).child($b).val()).exists()) || (newData.parent().parent().parent().child('adminOps').child('rm').child($s).child($b).isString() && root.child('booking').child('admin').child(newData.parent().parent().parent().child('adminOps').child('rm').child($s).child($b).val()).exists())))",
            ".validate": "newData.hasChildren(['name', 'enc', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 60 && newData.child('enc').isString() && newData.child('enc').val().length <= 1200 && newData.child('createdAt').val() == now",
            "$other": {
              ".validate": "$other == 'name' || $other == 'enc' || $other == 'createdAt'"
            }
          }
        }
      },
      "keys": {
        "$s": {
          "$b": {
            "$key": {
              ".write": "!data.exists() && !root.child('booking').child('sessions').child($s).child($b).exists() && $key.length >= 20 && $key.length <= 64",
              ".validate": "newData.val() === true"
            }
          }
        }
      },
      "cancels": {
        "$s": {
          "$b": {
            ".write": "root.child('booking').child('sessions').child($s).child($b).exists()",
            ".validate": "newData.isString() && newData.val().length <= 64"
          }
        }
      },
      "adminOps": {
        "rm": {
          "$s": {
            "$b": {
              ".write": "newData.isString() && root.child('booking').child('admin').child(newData.val()).exists()"
            }
          }
        },
        "close": {
          "$s": {
            "$cid": {
              ".write": "!data.exists() && newData.isString() && root.child('booking').child('admin').child(newData.val()).exists()"
            }
          }
        }
      },
      "closures": {
        ".read": true,
        "$s": {
          "$cid": {
            ".write": "!data.exists() && newData.parent().parent().parent().child('adminOps').child('close').child($s).child($cid).isString()",
            ".validate": "newData.hasChildren(['closed', 'at']) && newData.child('closed').isBoolean() && newData.child('at').val() == now && (!newData.hasChild('reason') || (newData.child('reason').isString() && newData.child('reason').val().length <= 120))"
          }
        }
      }
    }
  }
}
