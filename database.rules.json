{
  "rules": {
    ".read": false,
    ".write": false,
    "poules": {
      "$code": {
        ".read": "$code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
        ".write": "data.exists() && !newData.exists() && newData.parent().parent().child('deletions').child($code).isString() && root.child('owners').child($code).child(newData.parent().parent().child('deletions').child($code).val()).exists()",
        "meta": {
          ".write": "!data.exists() && $code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
          ".validate": "newData.hasChildren(['id', 'name', 'fencers', 'bouts'])"
        },
        "results": {
          "$bout": {
            ".write": "root.child('poules').child($code).child('meta').exists() && $bout.length <= 80",
            ".validate": "newData.hasChildren(['scoreL', 'scoreR', 'winnerId']) && newData.child('scoreL').isNumber() && newData.child('scoreR').isNumber() && newData.child('scoreL').val() >= 0 && newData.child('scoreL').val() <= 99 && newData.child('scoreR').val() >= 0 && newData.child('scoreR').val() <= 99 && newData.child('winnerId').isString() && newData.child('winnerId').val().length <= 80"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "owners": {
      "$code": {
        "$key": {
          ".write": "!data.exists() && !root.child('poules').child($code).child('meta').exists() && $code.matches(/^[A-HJKMNP-Z2-9]{6}$/)",
          ".validate": "newData.isBoolean() && $key.length >= 20 && $key.length <= 64"
        }
      }
    },
    "deletions": {
      "$code": {
        ".write": "root.child('owners').child($code).exists()",
        ".validate": "newData.isString() && newData.val().length <= 64"
      }
    }
  }
}
